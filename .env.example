# Website Doctor Configuration

# Server Port
PORT=3001
NODE_ENV=development

# Database Storage:
# Leave blank to automatically use embedded persistent PostgreSQL (PGlite)
# Or provide standard connection string: postgresql://user:password@localhost:5432/website_doctor
DATABASE_URL=

# AI Doctor Engine:
# Optional Google Gemini or OpenAI/OpenRouter API key.
# If omitted, Website Doctor automatically operates using its built-in factual Expert Heuristic Diagnostic Engine
AI_API_KEY=
AI_PROVIDER=heuristic

# Authentication Secret
AUTH_SECRET=website-doctor-super-secure-secret-key-change-in-production

# Email Provider (Optional for alerts):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-api-key
# ALERT_FROM_EMAIL=alerts@websitedoctor.local

# Frontend Environment Variables (for Vercel / Netlify frontend deployments):
# Set this to your deployed backend API URL (e.g. https://website-doctor.onrender.com)
VITE_API_BASE_URL=
